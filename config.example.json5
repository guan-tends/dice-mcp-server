// Dice MCP Server configuration
// Copy to config.json5 and adjust as needed. All fields optional.
// Environment overrides: DICE_MCP_PORT, DICE_MCP_HOST, DICE_MCP_CONFIG (config path)
{
  port: 3777,          // HTTP port for the MCP server
  host: '127.0.0.1',   // NOTE: currently INERT — mcp-ai SimpleServer's
                       // express listen() binds all interfaces and ignores
                       // this field. Loopback-only enforcement is done at
                       // the systemd layer (IPAddressDeny=any /
                       // IPAddressAllow=localhost) plus UFW default-deny.
                       // Documented until mcp-ai supports server-side host.
}
