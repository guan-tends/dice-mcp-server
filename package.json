{
  "name": "@guan-tends/dice-mcp-server",
  "version": "1.3.1",
  "description": "Stateless dice engine MCP tool server - generic d20-style notation, L5R 4e Roll & Keep, and L5R 5e ring/skill symbol dice, via the Model Context Protocol.",
  "type": "module",
  "main": "src/mcp-server.js",
  "exports": {
    ".": "./src/mcp-server.js",
    "./server": "./src/mcp-server.js",
    "./mcp-server.js": "./src/mcp-server.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ __tests__/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "format": "prettier --write src/ __tests__/",
    "format:check": "prettier --check src/ __tests__/",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "dice",
    "rpg",
    "ttrpg",
    "d20",
    "l5r",
    "legend-of-the-five-rings",
    "roll-and-keep",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "tools"
  ],
  "files": [
    "src/",
    "bin/",
    "config.example.json5",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@guan-tends/mcp-ai": "^1.6.5-guan.0",
    "json5": "^2.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "vitest": "4.1.11",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "author": {
    "name": "Guan",
    "url": "https://github.com/guan-tends"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guan-tends/dice-mcp-server.git"
  },
  "bin": {
    "dice-mcp-server": "./bin/dice-mcp-server.mjs"
  }
}
